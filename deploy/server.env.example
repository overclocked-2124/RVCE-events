# Copy this file to deploy/server.env on the deployment server only.
# Do not commit deploy/server.env.

# Image registry and release tag. The deploy script temporarily overrides IMAGE_TAG.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-owner
IMAGE_TAG=main

# The frontend is bound only to loopback. A reverse proxy on the server should
# terminate TLS and proxy public traffic to this port.
FRONTEND_PORT=3000

# PostgreSQL. Use a long random value for POSTGRES_PASSWORD.
POSTGRES_DB=rvce_events
POSTGRES_USER=rvce_events_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Google OAuth 2.0 Institutional Credentials & Session Key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
AUTH_SECRET=replace-with-a-long-random-session-secret-min-32-chars
NEXT_PUBLIC_APP_URL=https://events.codingclubrvce.com

